{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OrbOffice",
  "version": "0.2.0",
  "identifier": "com.orbtechnologies.orboffice",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "OrbOffice",
        "width": 1180,
        "height": 800,
        "minWidth": 860,
        "minHeight": 600,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "shortDescription": "A lightweight, private desktop office workspace",
    "longDescription": "OrbOffice is a local-first desktop office suite. Documents are stored on the user's device.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": true,
        "languages": [
          "English",
          "Turkish",
          "German",
          "French",
          "Spanish",
          "SpanishInternational",
          "Italian",
          "Dutch",
          "Arabic",
          "Hebrew",
          "Japanese",
          "Korean",
          "PortugueseBR",
          "Russian",
          "SimpChinese",
          "TradChinese",
          "Farsi",
          "Bulgarian"
        ],
        "startMenuFolder": "Orb Technologies",
        "compression": "lzma",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      },
      "allowDowngrades": false
    },
    "icon": [
      "icons/icon.ico"
    ]
  }
}
